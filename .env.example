# Copy to .env and fill in. .env is git-ignored and docker-ignored: it never reaches Git or an image.
# Keep comments on their own lines (inline comments after a value can be read as part of it).

# --- DagsHub / MLflow (Task 3.2) ---
DAGSHUB_USER=your-dagshub-username
MLFLOW_TRACKING_URI=https://dagshub.com/your-dagshub-username/23L-0764_A2_Ops.mlflow
MLFLOW_TRACKING_USERNAME=your-dagshub-username
# DagsHub -> avatar -> Your settings -> Tokens
MLFLOW_TRACKING_PASSWORD=your-dagshub-access-token

# --- Database (Task 5 / 6.3) ---
POSTGRES_DB=visionguard
POSTGRES_USER=visionguard
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# --- Web app (Task 4) ---
SECRET_KEY=change-me-to-another-long-random-string
# local = model inside the web container, remote = call the cloud model API
INFERENCE_MODE=local
# empty = use the threshold chosen on validation data (stored in models/champion.json)
THRESHOLD=
MAX_UPLOAD_MB=5
# false builds a much smaller web image (no TensorFlow) for INFERENCE_MODE=remote
WITH_TF=true

# --- Cloud model API (Tasks 7 / 8) ---
MODEL_API_URL=https://your-deployed-api.example.com
# generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MODEL_API_KEY=replace-me
